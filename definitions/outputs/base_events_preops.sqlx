config {
  type: "operations",
  schema: dataform.projectConfig.vars.CORE_DATASET,
  description: "Deletes the trailing reconciliation window (RECONCILIATION_LOOKBACK_DAYS in core_config.js) from base_events before refresh (skips if table doesn't exist)",
  tags: ["daily", "ga4", "core"],
  hasOutput: false,
  dependencies: []
}

js {
  const helpers = require('includes/helper.js');
  const config = helpers.getConfig();
  const lookbackDays = config.RECONCILIATION_LOOKBACK_DAYS;
}

DECLARE table_exists BOOL DEFAULT FALSE;

SET table_exists = (
  SELECT COUNT(*) > 0
  FROM `${dataform.projectConfig.vars.SOURCE_PROJECT}.${dataform.projectConfig.vars.CORE_DATASET}.INFORMATION_SCHEMA.TABLES`
  WHERE table_name = 'base_events'
);

IF table_exists THEN
  DELETE FROM `${dataform.projectConfig.vars.SOURCE_PROJECT}.${dataform.projectConfig.vars.CORE_DATASET}.base_events`
  WHERE event_date >= DATE_SUB(CURRENT_DATE(), INTERVAL ${lookbackDays} DAY)
    AND event_date <= DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY);
END IF;
